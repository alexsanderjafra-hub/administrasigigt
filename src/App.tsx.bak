                {["Minggu Ini", "Bulan Ini", "Tahun Ini"].map((p) => (
                  <button
                    key={p}
                    onClick={() => setPeriod(p)}
                    className={`px-4 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest transition-all ${
                      period === p
                        ? "bg-slate-100 text-slate-900"
                        : "text-slate-400 hover:text-slate-500"
                    }`}
                  >
