                  </p>
                  <p className="text-2xl font-black text-slate-900">
                    {formatCurrencyIDR(
                      showPaymentModal.amount -
                        (showPaymentModal.payments || []).reduce(
                          (a, b) => a + b.amount,
                          0,
                        ),
                    )}
